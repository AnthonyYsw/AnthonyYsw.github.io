# ===================================================================
# Jekyll & GitHub Pages
#
# Generated by https://www.toptal.com/developers/gitignore/api/jekyll
# Edit at https://www.toptal.com/developers/gitignore/templates/jekyll
# ===================================================================

# Directory that contains the built site.
# This is the most important rule.
_site/

# Directory that contains all of the Sass files that are imported.
# Usually you want to commit this directory, but if you have a build
# process that generates this directory, you should ignore it.
# assets/css/

# Caches for Jekyll and Sass.
.sass-cache/
.jekyll-cache/

# Files used by the Jekyll new and theme commands.
.jekyll-metadata

# Directory that contains Gems needed for the project.
.bundle/
vendor/

# If you have node-based tooling.
node_modules/
package-lock.json
yarn.lock

# Log files.
*.log

# ===================================================================
# Operating System Files
# ===================================================================

# OSX
# ===================================================================
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items

# Windows
# ===================================================================
# Windows thumbnail cache files
Thumbs.db
ehthumbs.db
ehthumbs_vista.db

# Folder config file
[Dd]esktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.msi
*.msu
*.msp

# ===================================================================
# Editor/IDE Files
# ===================================================================

# VSCode
.vscode/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Atom
.atom/

# JetBrains IDEs (IntelliJ, RubyMine, etc.)
.idea/

